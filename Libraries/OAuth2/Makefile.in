#
# Makefile for Mulberry's OAuth2 core (libOAuth2.a), its test tool
# oauth2-tool and its unit tests oauth2-unit.  See README.md and
# OAUTH2-PLAN.md.
#
# The core does not depend on JX or on the rest of Mulberry, and it is
# compiled without Mulberry's prefix header.  It contains no product name:
# only the test tool receives the application identity, from configure.
#
# Compatibility: GNU
#

.PHONY: all clean distclean check install uninstall

CXX = @CXX@
AR = @AR@
INSTALL = @INSTALL@
O = .o
A = .a

# The system provider file is installed into $(SYSCONFDIR)/<app id>/
DESTDIR = @DESTDIR@
SYSCONFDIR = @OAUTH2_SYSCONFDIR@
PROVIDER_FILE = oauth2-providers.conf.json

include ../../Build/make.version

# Application identity (configure --with-app-id)
APP_ID = @APP_ID@
APP_NAME = @APP_NAME@
APP_VERSION = $(subst _,.,$(MUL_VERSION))

CURL_CFLAGS = @CURL_CFLAGS@
CURL_LIBS = @CURL_LIBS@
SODIUM_CFLAGS = @SODIUM_CFLAGS@
SODIUM_LIBS = @SODIUM_LIBS@
SYS_LIBS = $(CURL_LIBS) $(SODIUM_LIBS)
TOOL_LIBS = @OAUTH2_TOOL_LIBS@

# thirdparty/: nlohmann/json, private to the library (thirdparty/README.md);
# values are read with explicit get<T>() only
CPPFLAGS = -Iinclude -Isrc -Ithirdparty -DJSON_USE_IMPLICIT_CONVERSIONS=0 \
	$(CURL_CFLAGS) $(SODIUM_CFLAGS)
CXXFLAGS = -std=gnu++17 -O2 -g -fPIC -Wall -Wextra -Wno-unused-parameter
TOOL_CPPFLAGS = -DOAUTH2_TOOL_APP_ID='"$(APP_ID)"' \
	-DOAUTH2_TOOL_APP_NAME='"$(APP_NAME)"' \
	-DOAUTH2_TOOL_APP_VERSION='"$(APP_VERSION)"' \
	-DOAUTH2_TOOL_SYSCONFDIR='"$(SYSCONFDIR)"'

LIBRARY = libOAuth2$A
SOURCES = Identity Version Encoding Random Pkce Redact Paths Permissions Provider \
	ProviderConfig JsonIndex HttpClient TokenClient Listener
OBJS = $(SOURCES:%=obj/%$O)

CONFDIR = $(DESTDIR)$(SYSCONFDIR)/$(APP_ID)

TOOL = oauth2-tool
UNIT = oauth2-unit
DRIVER = oauth2-token-driver
LISTENER = oauth2-listener-driver

all: $(LIBRARY) $(TOOL)

obj/%$O: src/%.cpp
	@mkdir -p obj
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c -o $@ $<

obj/tools/%$O: tools/%.cpp
	@mkdir -p obj/tools
	$(CXX) $(CPPFLAGS) $(TOOL_CPPFLAGS) $(CXXFLAGS) -MMD -MP -c -o $@ $<

obj/tests/%$O: tests/%.cpp
	@mkdir -p obj/tests
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c -o $@ $<

$(LIBRARY): $(OBJS)
	rm -f $@
	$(AR) rcs $@ $(OBJS)

# The identity flags are in the object: rebuild it when configure changes
obj/tools/oauth2-tool$O: Makefile

$(TOOL): obj/tools/oauth2-tool$O $(LIBRARY)
	$(CXX) -o $@ obj/tools/oauth2-tool$O $(LIBRARY) $(SYS_LIBS) $(TOOL_LIBS)

$(UNIT): obj/tests/unit$O $(LIBRARY)
	$(CXX) -o $@ obj/tests/unit$O $(LIBRARY) $(SYS_LIBS) $(TOOL_LIBS)

$(DRIVER): obj/tests/token-driver$O $(LIBRARY)
	$(CXX) -o $@ obj/tests/token-driver$O $(LIBRARY) $(SYS_LIBS) $(TOOL_LIBS)

# Its cancellation test uses a thread
$(LISTENER): obj/tests/listener-driver$O $(LIBRARY)
	$(CXX) -pthread -o $@ obj/tests/listener-driver$O $(LIBRARY) $(SYS_LIBS) $(TOOL_LIBS)

# Offline checks: no network, no account.  The unit tests read
# data/$(PROVIDER_FILE) and create their temporary files in obj/tests/; the
# tool validates the shipped system file as the application would; the
# token client runs against a mock server on 127.0.0.1 (Python 3, output in
# obj/tests/token/); the loopback listener is tested with curl as the
# browser (output in obj/tests/listener/).
check: all $(UNIT) $(DRIVER) $(LISTENER)
	./$(UNIT)
	./$(TOOL) --version
	./$(TOOL) --system-config data/$(PROVIDER_FILE) --no-user-config providers > /dev/null
	@echo "data/$(PROVIDER_FILE): valid"
	sh tests/token-tests.sh ./$(DRIVER) tests obj/tests/token
	sh tests/listener-tests.sh ./$(LISTENER) obj/tests/listener

# The system provider file (OAUTH2-PLAN.md, section 7); oauth2-tool stays in
# the build tree (decision D7)
install:
	$(INSTALL) -d $(CONFDIR)
	$(INSTALL) -m 644 data/$(PROVIDER_FILE) $(CONFDIR)/$(PROVIDER_FILE)

uninstall:
	rm -f $(CONFDIR)/$(PROVIDER_FILE)
	-rmdir $(CONFDIR) 2>/dev/null

clean:
	rm -rf obj $(LIBRARY) $(TOOL) $(UNIT) $(DRIVER) $(LISTENER)

distclean: clean

-include $(wildcard obj/*.d obj/tools/*.d obj/tests/*.d)
