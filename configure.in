dnl Process this file with autoconf to produce a configure script.
AC_INIT(Libraries/CICalendar/Source/CICalendarDurationValue.cpp)

# ---------------------------------------------------------------------------
# Checks for compilers and tools
# ---------------------------------------------------------------------------

AC_PROG_CXX
AC_PROG_CC
AC_PROG_INSTALL
AC_PROG_LN_S

AC_CHECK_PROG(AR, ar, ar)
if test -z "$AR"; then
   AC_MSG_ERROR("ar not found. Make sure it is in the PATH and rerun configure.")
fi
AC_SUBST(AR)

AC_CHECK_PROG(STRIP, strip, strip)
AC_SUBST(STRIP)

AC_LANG(C++)

dnl Checks for header files.

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_TYPE_SIZE_T

# ---------------------------------------------------------------------------
# Checks for platform and compiler features
# ---------------------------------------------------------------------------

AC_CANONICAL_HOST
case "$host_os" in
  *irix*)
    CXX="$CXX -LANG:std"
    if test -z "$PRELINK"; then
      PRELINK="/usr/lib/DCC/edg_prelink"
    fi
    if test -z "$CXXWARN"; then
      CXXWARN=""
    fi
    JX_TARGET=""
    ;;
  gnu*|linux*)
    case $host_cpu in
      ppc)
        JX_TARGET="linuxppc2000"
        ;;
      i*86|i*86pc)
        JX_TARGET="linux_intel"
        ;;
      x86_64|amd64)
        JX_TARGET="linux_intel_x86_64"
        ;;
    esac
    ;;
  freebsd*)
    case $host_cpu in
      x86_64|amd64)
        JX_TARGET="freebsd_amd64"
        # The JX/ACE FreeBSD configuration is for GCC (see
        # Libraries/JX/include/make/sys/FreeBSD-amd64-gcc)
        if ! $CXX -v 2>&1 | grep '^gcc version' >/dev/null; then
          AC_MSG_ERROR([On FreeBSD Mulberry must be built with GCC from packages, e.g.: CC=gcc14 CXX=g++14 ./configure (or use scripts/build-freebsd.sh)])
        fi
        ;;
      *)
        AC_MSG_ERROR([FreeBSD on $host_cpu is not supported yet (only amd64 has a JX configuration)])
        ;;
    esac
    ;;
  bsd4.4*|netbsd*)
    JX_TARGET="freebsd3_x"
    ;;
  SunOS|Solaris|solaris*)
    JX_TARGET="sunos5.8-g++"
    AC_MSG_WARN([Setting JX target to $JX_TARGET - this may be wrong (check configure.in)])
    ;;
esac
case $CC in
  gcc*|g++*|c++*|*-g++)
    CWARN="-Wall -Wcast-align -Wno-multichar -Wno-unused -Wno-unknown-pragmas"
    CFLAGS="$CFLAGS -std=c99 -fPIC"
    HAS_MM="yes"
    ;;
esac
case $CXX in
  gcc*|g++*|c++*|*-g++)
    CXXWARN="-Wall -Wextra -Wshadow -Wformat=2 -Wundef -Wnull-dereference -Wlogical-op -Wduplicated-cond -Wduplicated-branches -Wcast-align -Wno-multichar -Wno-unused -Wno-unused-parameter -Wno-unknown-pragmas -Wno-non-virtual-dtor -Wno-ctor-dtor-privacy"
    CXXFLAGS="$CXXFLAGS -fPIC"
    #GVERSION=`$CXX --version | grep "^$CXX " | sed "s/.* //"`
    GVERSION=`$CXX -dumpversion`
    case $GVERSION in
	*)
	  CXXWARN="$CXXWARN -Wno-deprecated"
	  CXXFLAGS="$CXXFLAGS "
	;;
    esac
    HAS_MM="yes"
    ;;
esac
CPPFLAGS=""
AC_ARG_WITH(extra-cppflags,
    [  --with-extra-cppflags   Specify additional flags to pass to the C preprocessor.],
    CPPFLAGS="${CPPFLAGS} $withval")

if test -z "$JX_TARGET"; then
AC_MSG_ERROR([Could not determine target system for JX build for OS "$host_os" and CPU "$host_cpu". Please edit configure.in and rerun autoconf / configure])
fi
AC_SUBST(JX_TARGET)

AC_SUBST(HAS_MM)
AC_SUBST(PRELINK)
AC_SUBST(CXXWARN)
AC_SUBST(CXXLANG)
AC_SUBST(CXXFLAGS)
AC_SUBST(CPPFLAGS)
AC_SUBST(CWARN)
AC_SUBST(CLANG)
AC_SUBST(CFLAGS)
AC_SUBST(CXX)
AC_SUBST(CC)

AC_SUBST(CXXOPT)

COPT="$CXXOPT"
AC_SUBST(COPT)

# ---------------------------------------------------------------------------
# Checks for Misc. stuff
# ---------------------------------------------------------------------------

LINK_STATIC="-Wl,-Bstatic"
LINK_DYNAMIC="-Wl,-Bdynamic"
AC_ARG_ENABLE(shared,
    [  --enable-shared         Use shared libraries instead of static for some dependencies.],
    LINK_STATIC=""
    LINK_DYNAMIC="")
AC_SUBST(LINK_STATIC)
AC_SUBST(LINK_DYNAMIC)

DESTDIR=""
AC_ARG_VAR(DESTDIR, The directory in which the prefix dir is located)

MULBERRY_DIR=".mulberry"
AC_ARG_WITH(mulberry-dir,
    [  --with-mulberry-dir     Specify location relative to the prefix where mulberry plugins go (default: .mulberry)],
    MULBERRY_DIR="$withval")
AC_SUBST(MULBERRY_DIR)

HELP_DIR=".mulberry"
AC_ARG_WITH(help-dir,
    [  --with-help-dir         Specify location relative to the prefix where mulberry documentation files go (default: .mulberry)],
    HELP_DIR="$withval")
AC_SUBST(HELP_DIR)

PROGRAM_DIR=""
AC_ARG_WITH(program-dir,
    [  --with-program-dir      Specify location relative to the prefix where the mulberry program goes (default: '')],
    PROGRAM_DIR="$withval")
AC_SUBST(PROGRAM_DIR)

# ---------------------------------------------------------------------------
# Checks for libs which we will need (fail if not found)
# ---------------------------------------------------------------------------

AC_CHECK_HEADER([esd.h],
	AC_DEFINE([HAVE_ESD], [1], [Define if esd.h is available]),
        AC_MSG_WARN([esd.h not found - EsounD support disabled (loaded dynamically via dlopen anyway).])
)

dnl cstdint is standard in C++11 and later — no fallback needed


# Checks for LDAP
AC_ARG_WITH(ldap-include,
    [  --with-ldap-include     Specify location of LDAP headers],
    LDAPINC="$withval")
if test -n "$LDAPINC"; then
    case $LDAPINC in
      -I*)
        ;;
      /*)
        LDAPINC=-I$LDAPINC
        ;;
      *)
        LDAPINC=-I`pwd`/$LDAPINC
        ;;
    esac
fi
AC_SUBST(LDAPINC)

LDAPLIB="-lldap -llber"
AC_ARG_WITH(ldap-libs,
    [  --with-ldap-libs        Specify link args for LDAP],
    LDAPLIB="$withval")
AC_SUBST(LDAPLIB)

CPPFLAGS_ORG="$CPPFLAGS"
CPPFLAGS="$LDAPINC $CPPFLAGS"
KERBEROS=""
AC_CHECK_HEADER([ldap_cdefs.h],
	COMMUNICATOR_ADBK_IO="CommunicatorAdbkIO"
	NETSCAPE_ADBK_IO="NetscapeAdbkIO",
        AC_MSG_ERROR(ldap_cdefs.h not found - mulberry and CommunicatorAdbkIO and NetscapeAdbkIO plugins require LDAP.)
)
CPPFLAGS="$CPPFLAGS_ORG"
AC_SUBST(COMMUNICATOR_ADBK_IO)
AC_SUBST(NETSCAPE_ADBK_IO)

# Checks for SSL

AC_ARG_WITH(openssl-include,
    [  --with-openssl-include  Specify location of openssl headers],
    SSLINC="$withval")
if test -n "$SSLINC"; then
    case $SSLINC in
      -I*)
        ;;
      /*)
        SSLINC=-I$SSLINC
        ;;
      *)
        SSLINC=-I`pwd`/$SSLINC
        ;;
    esac
fi
AC_SUBST(SSLINC)

CPPFLAGS_ORG="$CPPFLAGS"
CPPFLAGS="$SSLINC $CPPFLAGS"
KERBEROS=""
AC_CHECK_HEADER([openssl/ssl.h],
	SSL="SSL"
	SMIME="SMIME",
        AC_MSG_ERROR(openssl/ssl.h not found - mulberry and SMIME and SSL plugins require OpenSSL.)
)
CPPFLAGS="$CPPFLAGS_ORG"
AC_SUBST(SMIME)
AC_SUBST(SSL)

SSLLIB="-lssl -lcrypto"
AC_ARG_WITH(openssl-libs,
    [  --with-openssl-libs     Specify link args for openssl],
    SSLLIB="$withval")
AC_SUBST(SSLLIB)


# ---------------------------------------------------------------------------
# Checks for libs which may or may not be there
# ---------------------------------------------------------------------------

LDFLAGS=""
AC_CHECK_LIB(rt, main, LDFLAGS="$LDFLAGS -lrt")
AC_CHECK_LIB(gen, main, LDFLAGS="$LDFLAGS -lgen")
AC_CHECK_LIB(fontconfig, main, LDFLAGS="$LDFLAGS -lfontconfig")
AC_CHECK_LIB(z, deflate, LDFLAGS="$LDFLAGS -lz", AC_MSG_ERROR([zlib required for IMAP COMPRESS support]))
AC_CHECK_LIB(brotlidec, BrotliDecoderCreateInstance,
    [LDFLAGS="$LDFLAGS -lbrotlidec"
     AC_DEFINE(HAVE_BROTLI, 1, [Define if brotli is available])],
    [AC_MSG_WARN([libbrotli not found, HTTP br encoding disabled])])
AC_CHECK_LIB(zstd, ZSTD_createDStream,
    [LDFLAGS="$LDFLAGS -lzstd"
     AC_DEFINE(HAVE_ZSTD, 1, [Define if zstd is available])],
    [AC_MSG_WARN([libzstd not found, HTTP zstd encoding disabled])])
case $host_os in
  *solaris*)
     LDFLAGS="$LDFLAGS -nodefaultlibs -lc -lm -lgcc"
     SO_LDFLAGS="-nodefaultlibs -lc -lm -lgcc -socket -lresolv"
     PROC_NAME="`uname -p`"
     ;;
  *)
     # -lresolv is added below only if the library exists
     # (FreeBSD has the resolver in libc and no libresolv)
     SO_LDFLAGS=""
     PROC_NAME="`uname -m`"
     ;;
esac
OS_NAME="$host_os"
REL_NAME="`uname -r`"
AC_SUBST(OS_NAME)
AC_SUBST(REL_NAME)
AC_SUBST(PROC_NAME)
AC_CHECK_LIB(resolv, main,
    [LDFLAGS="$LDFLAGS -lresolv"
     SO_LDFLAGS="$SO_LDFLAGS -lresolv"])

# FreeBSD: JX/ACE are configured for GCC from packages (lang/gccNN), and
# the whole program must use the same C++ runtime.  GCC keeps its runtime
# (libstdc++, libgcc_s) in /usr/local/lib/gccNN: record it as rpath so
# that the base system's /lib/libgcc_s.so.1 is not used at run time.
case "$host_os" in
  freebsd*)
    GCC_RUNTIME_DIR=`$CXX -print-file-name=libstdc++.so 2>/dev/null`
    case "$GCC_RUNTIME_DIR" in
      /*)
        GCC_RUNTIME_DIR=`cd "\`dirname "$GCC_RUNTIME_DIR"\`" && pwd -P`
        LDFLAGS="$LDFLAGS -Wl,-rpath,$GCC_RUNTIME_DIR"
        SO_LDFLAGS="$SO_LDFLAGS -Wl,-rpath,$GCC_RUNTIME_DIR"
        ;;
    esac
    ;;
esac

AC_SUBST(LDFLAGS)
AC_SUBST(SO_LDFLAGS)

# ---------------------------------------------------------------------------
# Checks for KRB4
# ---------------------------------------------------------------------------

AC_ARG_WITH(krb4-include,
    [  --with-krb4-include     Specify location of kerberos4 headers],
    KRB4INC="$withval")
if test -n "$KRB4INC"; then
    case $KRB4INC in
      -I*)
        ;;
      /*)
        KRB4INC=-I$KRB4INC
        ;;
      *)
        KRB4INC=-I`pwd`/$KRB4INC
        ;;
    esac
fi

CPPFLAGS_ORG="$CPPFLAGS"
CPPFLAGS="$KRB4INC $CPPFLAGS"
KERBEROS=""
AC_CHECK_HEADER([krb.h],
	KERBEROS="Kerberos",
        AC_MSG_WARN(krb.h not found - disabling Kerberos (IV) plugin.)
)
CPPFLAGS="$CPPFLAGS_ORG"

KRB4LIB="-lkrb4 -ldes425"
AC_ARG_WITH(krb4-libs,
    [  --with-krb4-libs        Specify link args for kerberos4],
    KRB4LIB="$withval")

AC_SUBST(KRB4INC)
AC_SUBST(KRB4LIB)
AC_SUBST(KERBEROS)

# ---------------------------------------------------------------------------
# Checks for KRB5
# ---------------------------------------------------------------------------

KRB5INC="-I/usr/include/gssapi"
AC_ARG_WITH(krb5-include,
    [  --with-krb5-include     Specify location of kerberos5 headers],
    KRB5INC="$withval")
if test -n "$KRB5INC"; then
    case $KRB5INC in
      -I*)
        ;;
      /*)
        KRB5INC=-I$KRB5INC
        ;;
      *)
        KRB5INC=-I`pwd`/$KRB5INC
        ;;
    esac
fi

CPPFLAGS_ORG="$CPPFLAGS"
CPPFLAGS="$KRB5INC $CPPFLAGS"
GSSAPI=""
AC_CHECK_HEADER([gssapi.h],
	GSSAPI="GSSAPI",
        AC_MSG_WARN(gssapi.h not found - disabling GSSAPI plugin.)
)
CPPFLAGS="$CPPFLAGS_ORG"

KRB5LIB="-lgssapi_krb5 -lkrb5 -lk5crypto -lcom_err"
AC_ARG_WITH(krb5-libs,
    [  --with-krb5-libs        Specify link args for kerberos5],
    KRB5LIB="$withval")

AC_SUBST(KRB5INC)
AC_SUBST(KRB5LIB)
AC_SUBST(GSSAPI)

# ---------------------------------------------------------------------------
# Checks for ASpell
# ---------------------------------------------------------------------------

ASPELLINC=""
AC_ARG_WITH(aspell-include,
    [  --with-aspell-include   Specify location of aspell headers],
    ASPELLINC="$withval")
if test -n "$ASPELLINC"; then
    case $ASPELLINC in
      -I*)
        ;;
      /*)
        ASPELLINC=-I$ASPELLINC
        ;;
      *)
        ASPELLINC=-I`pwd`/$ASPELLINC
        ;;
    esac
fi

CPPFLAGS_ORG="$CPPFLAGS"
CPPFLAGS="$ASPELLINC $CPPFLAGS"
ASPELL=""
AC_CHECK_HEADER([aspell.h],
	ASPELL="ASpell",
        AC_MSG_WARN(aspell.h not found - disabling ASpell plugin.)
)
CPPFLAGS="$CPPFLAGS_ORG"

ASPELLLIB="-dynamic -laspell"
AC_ARG_WITH(aspell-libs,
    [  --with-aspell-libs      Specify link args for aspell],
    ASPELLLIB="$withval")

AC_SUBST(ASPELLINC)
AC_SUBST(ASPELLLIB)
AC_SUBST(ASPELL)

AC_ARG_WITH(libxml2,
    [  --without-libxml2       disable libxml2 XML parser],
    [with_libxml2=$withval],
    [with_libxml2=auto])

XML_PARSER_OBJ="Source/XMLSAXSimple\$O"
if test "$with_libxml2" != "no"; then
    LIBXML2_CFLAGS=`xml2-config --cflags 2>/dev/null`
    LIBXML2_LIBS=`xml2-config --libs 2>/dev/null`
    if test -n "$LIBXML2_CFLAGS"; then
        CPPFLAGS="$CPPFLAGS $LIBXML2_CFLAGS -DHAVE_LIBXML2"
        LIBS="$LIBS $LIBXML2_LIBS"
        XML_PARSER_OBJ="Source/XMLSAXlibxml2\$O"
        echo "using libxml2 for XML parsing"
    else
        if test "$with_libxml2" = "yes"; then
            echo "error: libxml2 requested but xml2-config not found"
            exit 1
        fi
        echo "libxml2 not found, using built-in XML parser"
    fi
fi
AC_SUBST(XML_PARSER_OBJ)
AC_SUBST(LIBXML2_CFLAGS)
AC_SUBST(LIBXML2_LIBS)

# ---------------------------------------------------------------------------
# libsodium (required for keyring encryption)
# ---------------------------------------------------------------------------

AC_CHECK_HEADER([sodium.h], [],
    AC_MSG_ERROR([sodium.h not found. Install libsodium-dev.]))
LDFLAGS="$LDFLAGS -lsodium"

# ---------------------------------------------------------------------------
# libunistring (required for PRECIS username/password normalization, RFC 8265)
# ---------------------------------------------------------------------------

AC_CHECK_HEADER([uninorm.h], [],
    AC_MSG_ERROR([uninorm.h not found. Install libunistring-dev.]))
LDFLAGS="$LDFLAGS -lunistring"

# ---------------------------------------------------------------------------
# HTML message viewer: litehtml with Cairo and HarfBuzz (stack S1 in
# LITEHTML-VIEWER-PLAN.md).  pixman, Cairo, HarfBuzz and litehtml come from
# git submodules and are built as static libraries in Libraries/htmldeps
# (Meson for the first three, CMake for litehtml); the viewer core is
# Libraries/HTMLView.  FreeType, fontconfig, libpng, zlib and the X11
# libraries are used from the system.
# ---------------------------------------------------------------------------

AC_ARG_ENABLE(html-viewer,
    [  --disable-html-viewer   build without the HTML message viewer (litehtml)],
    [enable_html_viewer=$enableval],
    [enable_html_viewer=yes])

HTML_VIEWER=""
HTMLVIEW_CPPFLAGS=""
HTMLVIEW_LIBS=""
HTMLVIEW_SYS_CFLAGS=""
HTMLVIEW_SYS_LIBS=""
if test "$enable_html_viewer" != "no"; then
    AC_PATH_PROG(MESON, meson)
    AC_PATH_PROG(NINJA, ninja)
    AC_PATH_PROG(CMAKE, cmake)
    AC_PATH_PROG(PKG_CONFIG, pkg-config)
    if test -z "$MESON" || test -z "$NINJA" || test -z "$CMAKE" || test -z "$PKG_CONFIG"; then
        AC_MSG_ERROR([meson, ninja, cmake and pkg-config are needed to build the HTML viewer (or configure with --disable-html-viewer)])
    fi

    for sub in litehtml/CMakeLists.txt pixman/meson.build cairo/meson.build harfbuzz/meson.build; do
        if test ! -f "$srcdir/Libraries/$sub"; then
            AC_MSG_ERROR([Libraries/$sub not found: run "git submodule update --init" (or configure with --disable-html-viewer)])
        fi
    done

    HTMLVIEW_PKGS="fontconfig freetype2 libpng zlib x11 xext xrender"
    AC_MSG_CHECKING([for the HTML viewer's system libraries ($HTMLVIEW_PKGS)])
    if $PKG_CONFIG --exists $HTMLVIEW_PKGS; then
        AC_MSG_RESULT([yes])
    else
        AC_MSG_RESULT([no])
        AC_MSG_ERROR([some of $HTMLVIEW_PKGS not found by pkg-config (or configure with --disable-html-viewer)])
    fi
    HTMLVIEW_SYS_CFLAGS=`$PKG_CONFIG --cflags $HTMLVIEW_PKGS`
    HTMLVIEW_SYS_LIBS="`$PKG_CONFIG --libs $HTMLVIEW_PKGS` -lunistring -lm -pthread"

    # Image decoders (PNG is Cairo's own): libjpeg (libjpeg-turbo) and
    # giflib are needed, libwebp is optional
    AC_MSG_CHECKING([for libjpeg])
    if $PKG_CONFIG --exists libjpeg; then
        AC_MSG_RESULT([yes])
        HTMLVIEW_SYS_CFLAGS="$HTMLVIEW_SYS_CFLAGS `$PKG_CONFIG --cflags libjpeg`"
        HTMLVIEW_SYS_LIBS="$HTMLVIEW_SYS_LIBS `$PKG_CONFIG --libs libjpeg`"
    else
        AC_MSG_RESULT([no])
        AC_MSG_ERROR([libjpeg (libjpeg-turbo) not found: it is needed by the HTML viewer (or configure with --disable-html-viewer)])
    fi
    AC_CHECK_HEADER([gif_lib.h], [],
        AC_MSG_ERROR([gif_lib.h (giflib) not found: it is needed by the HTML viewer (or configure with --disable-html-viewer)]))
    AC_CHECK_LIB(gif, DGifOpen, [HTMLVIEW_SYS_LIBS="$HTMLVIEW_SYS_LIBS -lgif"],
        AC_MSG_ERROR([libgif (giflib) not found: it is needed by the HTML viewer (or configure with --disable-html-viewer)]))
    # Remote images are downloaded with libcurl
    AC_MSG_CHECKING([for libcurl])
    if $PKG_CONFIG --exists libcurl; then
        AC_MSG_RESULT([yes])
        HTMLVIEW_SYS_CFLAGS="$HTMLVIEW_SYS_CFLAGS `$PKG_CONFIG --cflags libcurl`"
        HTMLVIEW_SYS_LIBS="$HTMLVIEW_SYS_LIBS `$PKG_CONFIG --libs libcurl`"
    else
        AC_MSG_RESULT([no])
        AC_MSG_ERROR([libcurl not found: it is needed by the HTML viewer for remote images (or configure with --disable-html-viewer)])
    fi
    AC_MSG_CHECKING([for libwebp (optional: WebP images in the HTML viewer)])
    if $PKG_CONFIG --exists libwebp; then
        AC_MSG_RESULT([yes])
        HTMLVIEW_SYS_CFLAGS="$HTMLVIEW_SYS_CFLAGS -DHTMLVIEW_WEBP `$PKG_CONFIG --cflags libwebp`"
        HTMLVIEW_SYS_LIBS="$HTMLVIEW_SYS_LIBS `$PKG_CONFIG --libs libwebp`"
    else
        AC_MSG_RESULT([no])
    fi

    # Test tool html2png: the GCC run-time directory as rpath (see above)
    HTMLVIEW_TOOL_LIBS=""
    if test -n "$GCC_RUNTIME_DIR"; then
        HTMLVIEW_TOOL_LIBS="-Wl,-rpath,$GCC_RUNTIME_DIR"
    fi

    # Static libraries are linked by full path: the system may have shared
    # libcairo and libpixman-1 that a -l option could pick instead.
    HTMLDEPS_LIBDIR="`pwd`/Libraries/htmldeps/dist/lib"
    HTML_VIEWER="yes"
    # Mulberry (Linux/Makefile): the viewer's interface and Cairo's headers
    # (the widget draws with Cairo on the X window); the static archives
    # (HTMLVIEW_LIBS, also make prerequisites) and after everything else the
    # system libraries they need (HTMLVIEW_SYS_LIBS)
    HTMLVIEW_CPPFLAGS="-DHTML_VIEWER -I`pwd`/Libraries/HTMLView/include -I`pwd`/Libraries/htmldeps/dist/include/cairo"
    HTMLVIEW_LIBS="`pwd`/Libraries/HTMLView/libHTMLView.a $HTMLDEPS_LIBDIR/liblitehtml.a $HTMLDEPS_LIBDIR/libgumbo.a $HTMLDEPS_LIBDIR/libharfbuzz.a $HTMLDEPS_LIBDIR/libcairo.a $HTMLDEPS_LIBDIR/libpixman-1.a"
    echo "HTML viewer enabled (litehtml, Cairo, HarfBuzz)"
else
    echo "HTML viewer disabled"
fi
AC_SUBST(HTML_VIEWER)
AC_SUBST(MESON)
AC_SUBST(NINJA)
AC_SUBST(CMAKE)
AC_SUBST(HTMLVIEW_CPPFLAGS)
AC_SUBST(HTMLVIEW_LIBS)
AC_SUBST(HTMLVIEW_SYS_CFLAGS)
AC_SUBST(HTMLVIEW_SYS_LIBS)
AC_SUBST(HTMLVIEW_TOOL_LIBS)

# ---------------------------------------------------------------------------
# Almost there...
# ---------------------------------------------------------------------------

test "$prefix" = "NONE" -o "$prefix" = "" && prefix='~'
echo ""
echo "Mulberry binary goes to $DESTDIR$prefix/$PROGRAM_DIR"
echo "Mulberry resources and plugins go to $DESTDIR$prefix/$MULBERRY_DIR"
echo "Mulberry help files go to $DESTDIR$prefix/$HELP_DIR"
echo ""

AC_CONFIG_FILES([Makefile Libraries/Makefile Libraries/HTMLView/Makefile Build/Makefile Sources_Common/Makefile Libraries/CICalendar/Makefile Libraries/vCard/Makefile Libraries/XMLLib/Makefile Linux/Makefile Plug-ins/Makefile Plug-ins/PluginLibrary/Makefile Plug-ins/CRAM-MD5/Makefile Plug-ins/DIGEST-MD5/Makefile Plug-ins/SCRAM-SHA-1/Makefile Plug-ins/SCRAM-SHA-256/Makefile Plug-ins/GSSAPI/Makefile Plug-ins/Kerberos/Makefile Plug-ins/CommunicatorAdbkIO/Makefile Plug-ins/Eudora4AdbkIO/Makefile Plug-ins/EudoraAdbkIO/Makefile Plug-ins/NetscapeAdbkIO/Makefile Plug-ins/PineAdbkIO/Makefile Plug-ins/QuickmailAdbkIO/Makefile Plug-ins/vCardAdbkIO/Makefile Plug-ins/ISpell/Makefile Plug-ins/ASpell/Makefile Plug-ins/GPG/Makefile Plug-ins/SMIME/Makefile Plug-ins/SSL/Makefile])
AC_OUTPUT
